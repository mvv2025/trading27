# Server-side only. Configure it in Vercel Project Settings → Environment Variables.
# Never use a VITE_ prefix for private API keys.
TWELVE_DATA_API_KEY=

# Límit de peticions (opcional). Sense Redis, el límit és per instància serverless
# (protecció parcial). Amb Upstash Redis, el comptador és compartit (recomanat).
# La integració d'Upstash a Vercel crea KV_REST_API_URL i KV_REST_API_TOKEN; també s'accepten:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Valors per defecte: 30 peticions/minut per IP; 8 crèdits/minut i 800/dia (pla Basic).
RATE_LIMIT_PER_IP_PER_MINUTE=30
MARKET_DATA_CREDITS_PER_MINUTE=8
MARKET_DATA_CREDITS_PER_DAY=800

# Full de càlcul públic amb preus de GOOGLEFINANCE (opcional; per defecte, el full del projecte).
# Ha d'estar compartit com a "Qualsevol persona que tingui l'enllaç → Lector".
MARKET_SHEET_ID=
